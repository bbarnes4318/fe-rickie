# Database connection string
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Server port
PORT=3001

# Admin login & JWT security settings
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me

# ============================================================================
# American Amicable Carrier RPA Settings
# ============================================================================
# Set to true to run with hardcoded test values (Sarah Williams)
AUTOMATION_TEST_MODE=false

# Your agent credentials for American Amicable
AMERICAN_AMICABLE_AGENT_ID=your-agent-id
AMERICAN_AMICABLE_PASSWORD=your-password

# Name used for agent electronic signature (e.g. Yazzyl Vasquez)
AMERICAN_AMICABLE_SIGNATURE_NAME=Your Agent Name

# Executable path for Puppeteer (e.g., in Docker, set to /usr/bin/chromium)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ============================================================================
# HopWhistle Telephony Integration
# ============================================================================
# API URL - Your HopWhistle API endpoint
VITE_HOPWHISTLE_API_URL=http://your-hopwhistle-server-ip:3001

# WebSocket URL - For real-time call events
VITE_HOPWHISTLE_WS_URL=ws://your-hopwhistle-server-ip:3001

# API Key - Your HopWhistle API key
VITE_HOPWHISTLE_API_KEY=your-api-key-here

# Tenant ID - Your tenant ID in HopWhistle
VITE_HOPWHISTLE_TENANT_ID=your-tenant-uuid-here

# Webhook Secret - For validating incoming webhooks
HOPWHISTLE_WEBHOOK_SECRET=your-webhook-signature-secret-here
